<%- include('partials/header', { title: '上传', currentCategory, categories, categoryCounts }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header bg-white">
        <h4 class="mb-0">⬆ 上传照片或视频</h4>
      </div>
      <div class="card-body">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show">
            <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <form action="/upload" method="POST" enctype="multipart/form-data" id="uploadForm">
          <!-- 文件选择 -->
          <div class="mb-4">
            <label class="form-label fw-bold">选择文件 *</label>
            <div class="upload-dropzone" id="dropzone">
              <div class="dropzone-content" id="dropzoneContent">
                <span class="upload-icon">📁</span>
                <p class="mb-1">拖拽文件到此处，或点击选择</p>
                <small class="text-muted">照片格式不限 · 视频常见格式均可</small>
                <br>
                <small class="text-muted">单文件最大 1GB · 可一次选择多个文件</small>
              </div>
              <div class="dropzone-preview d-none" id="dropzonePreview">
                <div id="previewContent"></div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="changeFileBtn">重新选择</button>
              </div>
              <input type="file" name="file" id="fileInput" class="d-none" multiple>
            </div>
            <div class="progress mt-2 d-none" id="uploadProgress">
              <div class="progress-bar progress-bar-striped progress-bar-animated" id="progressBar" style="width: 0%">0%</div>
            </div>
          </div>

          <!-- 标题 -->
          <div class="mb-3">
            <label for="title" class="form-label fw-bold">标题</label>
            <input type="text" class="form-control" id="title" name="title" placeholder="可选，默认使用文件名" maxlength="100">
          </div>

          <!-- 分类 -->
          <div class="mb-3">
            <label class="form-label fw-bold">分类 *</label>
            <div class="d-flex flex-wrap gap-2" id="categoryGroup">
              <% (typeof categories !== 'undefined' ? categories : []).forEach(function(cat) { %>
              <div class="form-check">
                <input class="form-check-input category-radio" type="radio" name="category" id="cat_<%= cat %>" value="<%= cat %>" required>
                <label class="form-check-label category-label" for="cat_<%= cat %>"><%= cat %></label>
              </div>
              <% }) %>
            </div>
          </div>

          <!-- 描述 -->
          <div class="mb-4">
            <label for="description" class="form-label fw-bold">描述</label>
            <textarea class="form-control" id="description" name="description" rows="3" placeholder="添加一段描述（可选）" maxlength="500"></textarea>
          </div>

          <!-- 私密选项 -->
          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="isPrivate" name="is_private" value="1">
            <label class="form-check-label" for="isPrivate">
              <span style="font-size:0.9rem">🔒 私密上传 — 仅自己可见（需登录密码查看）</span>
            </label>
          </div>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn" disabled>
              上传
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
